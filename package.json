{
  "name": "inmobiliaria-raiz-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "dotenv -e .env -- concurrently -n API,WEB -c blue,green \"npm run start:dev -w @inmobiliaria/api\" \"npm run dev -w @inmobiliaria/web\"",
    "build": "npm run build -w @inmobiliaria/api && npm run build -w @inmobiliaria/web",
    "db:generate": "dotenv -e .env -- npm run prisma:generate -w @inmobiliaria/api",
    "db:migrate": "dotenv -e .env -- npm run db:migrate -w @inmobiliaria/api",
    "db:seed": "dotenv -e .env -- npm run db:seed -w @inmobiliaria/api",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv-cli": "^8.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
